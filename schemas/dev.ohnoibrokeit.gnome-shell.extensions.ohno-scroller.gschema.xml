<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="dev.ohnoibrokeit.gnome-shell.extensions.ohno-scroller" path="/dev/ohnoibrokeit/gnome-shell/extensions/ohno-scroller/">
    <key name="tiling-enabled" type="b">
      <default>true</default>
      <summary>Enable tiling</summary>
      <description>Whether the extension should manage normal windows on the active workspace.</description>
    </key>
    <key name="gap-size" type="i">
      <default>10</default>
      <range min="0" max="64"/>
      <summary>Gap size</summary>
      <description>Pixels between tiled windows and columns.</description>
    </key>
    <key name="column-width-percent" type="i">
      <default>50</default>
      <range min="25" max="100"/>
      <summary>Default column width percent (scrolling mode)</summary>
      <description>Width of a newly created scrolling column as a percent of the monitor work area.</description>
    </key>
    <key name="default-layout-mode" type="s">
      <choices>
        <choice value="bsp"/>
        <choice value="scrolling"/>
      </choices>
      <default>'bsp'</default>
      <summary>Layout mode new workspaces start in</summary>
      <description>Bounded splits (bsp) or scrolling columns. Each workspace can be toggled at runtime with the toggle-layout-mode shortcut.</description>
    </key>
    <key name="debug-logging" type="b">
      <default>false</default>
      <summary>Enable debug logging</summary>
      <description>Log retile activity, suppressed retiles, skipped placements, and crowded tiles to the journal for troubleshooting.</description>
    </key>
    <key name="toggle-tiling" type="as">
      <default>['&lt;Super&gt;y']</default>
      <summary>Toggle tiling</summary>
    </key>
    <key name="toggle-layout-mode" type="as">
      <default>['&lt;Super&gt;&lt;Control&gt;y']</default>
      <summary>Toggle the active workspace between split and scrolling layout</summary>
    </key>
    <key name="stack-window-left" type="as">
      <default>['&lt;Super&gt;comma']</default>
      <summary>Merge focused window into the column to the left (scrolling mode)</summary>
    </key>
    <key name="stack-window-right" type="as">
      <default>['&lt;Super&gt;period']</default>
      <summary>Merge focused window into the column to the right (scrolling mode)</summary>
    </key>
    <key name="retile-workspace" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;y']</default>
      <summary>Retile workspace</summary>
    </key>
    <key name="focus-column-left" type="as">
      <default>['&lt;Super&gt;h']</default>
      <summary>Focus column left</summary>
    </key>
    <key name="focus-column-right" type="as">
      <default>['&lt;Super&gt;l']</default>
      <summary>Focus column right</summary>
    </key>
    <key name="move-window-left" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;h']</default>
      <summary>Move focused window left</summary>
    </key>
    <key name="move-window-right" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;l']</default>
      <summary>Move focused window right</summary>
    </key>
    <key name="move-window-new-column" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;Return']</default>
      <summary>Move focused window to a new column</summary>
    </key>
    <key name="focus-up" type="as">
      <default>['&lt;Super&gt;k']</default>
      <summary>Focus tile above</summary>
    </key>
    <key name="focus-down" type="as">
      <default>['&lt;Super&gt;j']</default>
      <summary>Focus tile below</summary>
    </key>
    <key name="move-window-up" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;k']</default>
      <summary>Move focused window up</summary>
    </key>
    <key name="move-window-down" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;j']</default>
      <summary>Move focused window down</summary>
    </key>
    <key name="equalize-ratios" type="as">
      <default>['&lt;Super&gt;equal']</default>
      <summary>Reset all split ratios on the active workspace to 50/50</summary>
    </key>
  </schema>
</schemalist>
